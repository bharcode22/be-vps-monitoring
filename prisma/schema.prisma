datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Server {
  id            Int      @id @default(autoincrement())
  name          String
  host          String
  port          Int      @default(22)
  username      String   @default("root")
  auth_type     String   @default("password")
  password      String?
  private_key   String?
  code          String?  @unique
  latitude      String?
  longitude     String?
  mac_address   String?
  pod_uuid      String?
  is_local      Int      @default(0)
  type          String   @default("vps") // 'vps' | 'pod'
  pod_version   String   @default("") // 'v2' | 'v3' | ''
  db_name       String   @default("")
  db_user       String   @default("")
  s3_endpoint   String   @default("")
  s3_access_key String   @default("")
  s3_secret_key String   @default("")
  s3_region     String   @default("us-east-1")
  s3_bucket     String   @default("")
  created_at    DateTime @default(now())

  deployments      DeploymentHistory[]
  app_versions     PodAppVersion[]
  pod_bundle_state PodBundleState?

  @@map("servers")
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  updated_at DateTime @default(now())

  @@map("settings")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String?
  picture    String?
  role       String   @default("admin")
  status     String   @default("pending")
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("users")
}

model DatabasePostgres {
  id         Int      @id @default(autoincrement())
  name       String
  host       String
  port       Int      @default(5432)
  db_name    String   @default("postgres")
  db_user    String   @default("postgres")
  password   String?
  created_at DateTime @default(now())

  @@map("databases_postgres")
}

model ObjectStorage {
  id            Int      @id @default(autoincrement())
  name          String
  type          String // 'minio' | 's3'
  s3_endpoint   String?
  s3_access_key String?
  s3_secret_key String?
  s3_region     String?  @default("us-east-1")
  s3_bucket     String?
  port          Int      @default(9000)
  created_at    DateTime @default(now())

  @@map("object_storages")
}

model RabbitMqServer {
  id         Int      @id @default(autoincrement())
  name       String
  host       String
  port       Int      @default(15672)
  username   String   @default("guest")
  password   String?
  created_at DateTime @default(now())

  @@map("rabbitmq_servers")
}

model DeploymentHistory {
  id                 Int      @id @default(autoincrement())
  batch_id           String?
  pod_code           String?
  server_name        String?
  app_name           String
  app_type           String   @default("backend") // 'backend' | 'frontend'
  environment        String   @default("dev") // 'dev' | 'release'
  version            String
  env_filename       String?
  run_prisma_migrate Boolean  @default(false)
  status             String   @default("pending") // 'running' | 'success' | 'failed'
  duration_seconds   Int      @default(0)
  logs               String?
  error_message      String?
  deployed_by        String?  @default("Admin")
  created_at         DateTime @default(now())

  server Server? @relation(fields: [pod_code], references: [code], onDelete: Cascade)

  @@index([pod_code])
  @@index([created_at])
  @@map("deployment_history")
}

model PodAppVersion {
  id                 Int      @id @default(autoincrement())
  pod_code           String
  app_name           String
  app_type           String   @default("backend") // 'backend' | 'frontend'
  environment        String   @default("dev") // 'dev' | 'release'
  current_version    String
  last_deployment_id Int?
  status             String   @default("active") // 'active' | 'outdated' | 'failed'
  installed_at       DateTime @default(now())
  updated_at         DateTime @default(now())

  server Server @relation(fields: [pod_code], references: [code], onDelete: Cascade)

  @@unique([pod_code, app_name], name: "uq_pod_app")
  @@index([pod_code])
  @@map("pod_app_versions")
}

model BundleDefinition {
  id             Int     @id @default(autoincrement())
  bundle_name    String  @unique
  bundle_version String
  environment    String  @default("dev") // 'dev' | 'release'
  description    String?

  // 5 Backend Microservices - Versi MinIO
  mobile_api_version        String
  mobile_synch_version      String
  mobile_consume_version    String
  mobile_downloader_version String
  assist_api_version        String

  // 5 Backend Microservices - File .env & Prisma Migrate Flag
  mobile_api_env    String? @default("")
  mobile_api_prisma Boolean @default(false)

  mobile_synch_env    String? @default("")
  mobile_synch_prisma Boolean @default(false)

  mobile_consume_env    String? @default("")
  mobile_consume_prisma Boolean @default(false)

  mobile_downloader_env    String? @default("")
  mobile_downloader_prisma Boolean @default(false)

  assist_api_env    String? @default("")
  assist_api_prisma Boolean @default(false)

  // 2 Frontend Screens (DEB)
  small_screen_version String
  big_screen_version   String

  created_by String?  @default("Admin")
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  pod_bundle_states PodBundleState[]

  @@map("bundle_definitions")
}

model PodBundleState {
  id                Int      @id @default(autoincrement())
  pod_code          String   @unique
  bundle_id         Int?
  custom_bundle_tag String?
  compliance_status String   @default("synced") // 'synced' | 'mismatched' | 'deploying'
  compliance_pct    Int      @default(100)
  last_deployed_by  String?  @default("Admin")
  last_deployed_at  DateTime @default(now())
  updated_at        DateTime @default(now())

  server Server            @relation(fields: [pod_code], references: [code], onDelete: Cascade)
  bundle BundleDefinition? @relation(fields: [bundle_id], references: [id], onDelete: SetNull)

  @@index([pod_code])
  @@map("pod_bundle_states")
}

model PodOccupancyLog {
  id               Int       @id @default(autoincrement())
  server_id        Int
  server_name      String?   @db.VarChar(100)
  server_code      String?   @db.VarChar(50)
  server_host      String?   @db.VarChar(50)
  state_value      Int
  state_label      String    @db.VarChar(30)
  topic            String?   @db.VarChar(255)
  raw_payload      String?   @db.Text
  duration_seconds Int?      @default(0)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([server_id], map: "idx_occupancy_logs_server_id")
  @@index([created_at(sort: Desc)], map: "idx_occupancy_logs_created_at")
  @@map("pod_occupancy_logs")
}
